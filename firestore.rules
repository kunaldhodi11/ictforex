rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Private account data: only the account owner can read it.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.accessLevel == 'Free'
                    && request.resource.data.courseAccess == 'free';

      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['fullName'])
                    && request.resource.data.fullName is string
                    && request.resource.data.fullName.size() <= 100;

      allow delete: if false;

      // A user controls only their own Following list.
      match /following/{targetUid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && targetUid != userId
                      && request.resource.data.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
        allow update: if false;
      }

      // A follower document is written by the follower, not by the profile owner.
      match /followers/{followerUid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.auth.uid == followerUid
                      && followerUid != userId
                      && request.resource.data.uid == followerUid;
        allow delete: if request.auth != null && request.auth.uid == followerUid;
        allow update: if false;
      }
    }

    // Safe public profile fields only. Never put email or account entitlements here.
    match /publicProfiles/{userId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.fullName is string
                    && request.resource.data.fullName.size() <= 100
                    && request.resource.data.bio is string
                    && request.resource.data.bio.size() <= 300
                    && (!('photoURL' in request.resource.data)
                        || (request.resource.data.photoURL is string
                            && request.resource.data.photoURL.size() <= 500));

      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['fullName', 'bio', 'photoURL'])
                    && request.resource.data.fullName is string
                    && request.resource.data.fullName.size() <= 100
                    && request.resource.data.bio is string
                    && request.resource.data.bio.size() <= 300
                    && (!('photoURL' in request.resource.data)
                        || (request.resource.data.photoURL is string
                            && request.resource.data.photoURL.size() <= 500));

      allow delete: if false;
    }

    // Community posts
    match /communityPosts/{postId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.authorName is string
                    && request.resource.data.authorName.size() <= 100
                    && request.resource.data.content is string
                    && request.resource.data.content.size() <= 3000
                    && request.resource.data.likes is list
                    && request.resource.data.createdAt == request.time;

      // Users may add or remove only their own like.
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['likes'])
                    && resource.data.likes is list
                    && request.resource.data.likes is list
                    && (
                      (
                        !resource.data.likes.hasAny([request.auth.uid])
                        && request.resource.data.likes.size()
                           == resource.data.likes.size() + 1
                        && request.resource.data.likes.hasAll(resource.data.likes)
                        && request.resource.data.likes.hasAny([request.auth.uid])
                      )
                      ||
                      (
                        resource.data.likes.hasAny([request.auth.uid])
                        && request.resource.data.likes.size()
                           == resource.data.likes.size() - 1
                        && resource.data.likes.hasAll(request.resource.data.likes)
                        && !request.resource.data.likes.hasAny([request.auth.uid])
                      )
                    );

      allow delete: if request.auth != null
                    && resource.data.authorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if request.auth != null;

        allow create: if request.auth != null
                      && request.resource.data.authorId == request.auth.uid
                      && request.resource.data.authorName is string
                      && request.resource.data.authorName.size() <= 100
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 600
                      && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }
  }
}